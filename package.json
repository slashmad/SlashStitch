{
  "name": "slashstitch",
  "productName": "SlashStitch",
  "version": "0.2.0",
  "description": "Cross-platform open-source panorama stitcher built on SlashAPP + Rust.",
  "author": "slashmad",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "setup:electron": "node node_modules/electron/install.js",
    "build:engine": "node scripts/build-engine.mjs",
    "build:engine:release": "node scripts/build-engine.mjs",
    "stage:engine": "node scripts/stage-engine.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:engine && npm run build:main && npm run build:renderer",
    "start": "node scripts/start.mjs",
    "dev": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:linux": "node scripts/package.mjs linux",
    "dist:win": "node scripts/package.mjs win32",
    "dist:mac": "node scripts/package.mjs darwin",
    "test:engine": "cargo test --manifest-path engine/Cargo.toml && cargo build --manifest-path engine/Cargo.toml --bin slashstitch-worker",
    "test": "npm run test:engine && node --test tests/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "pack": "node scripts/package.mjs --dir",
    "release:checksums": "node scripts/release-checksums.mjs",
    "icon": "node scripts/sync-icons.mjs",
    "build:notices": "node scripts/build-notices.mjs",
    "build:engine:debug": "cargo build --manifest-path engine/Cargo.toml --bin slashstitch-worker",
    "smoke:regressions": "npm run build && node scripts/regression-smoke.mjs",
    "verify:images": "node scripts/verify-real-images.mjs"
  },
  "dependencies": {
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "desktopName": "slashstitch.desktop",
  "homepage": "https://github.com/slashmad/SlashStitch",
  "repository": {
    "type": "git",
    "url": "https://github.com/slashmad/SlashStitch.git"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
